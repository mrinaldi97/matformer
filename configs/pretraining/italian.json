{
  "model_class": "Autoregressive_Model",
  "model_config": {
    "name": "ItalianLM",
    "hidden_size": 768,
    "ffn_factor": 3.0,
    "num_hidden_layers": 12,
    "num_attention_heads": 12,
    "vocab_size": 32768,
    "bos_token_id": 5,
    "eos_token_id": 6,
    "pad_token_id": 0,
    "tie_word_embeddings": false,
    "rms_norm_eps": 1e-06,
    "attention_type": [],
    "max_position_embeddings": 512,
    "block_size_for_attention": 128,
    "rope_theta": 10000.0,
    "compile_flexattn": false,
    "bias": false,
    "training_objective": "autoregressive",
    "is_causal": true,
    "default_layer": {
      "attn_impl": "sdpa",
      "sliding_window_size": null,
      "positional_encoding": "alibi",
      "normalization": "rmsnorm",
      "normalization_position": "post",
      "ffn_activation": "swiglu",
      "hooks": {}
    },
    "custom_layers": {},
    "mask_token_id": 4,
    "num_loops": 1
  },
  "training": {
    "optimizer": "adamw",
    "lr": 0.0003,
    "final_lr": 3e-05,
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.1,
    "lr_scheduling": true,
    "scheduler": "cosine",
    "warmup_steps": 1000,
    "schedule_steps": 100000,
    "gradient_clip_val": 1.0,
    "max_epochs": 1,
    "accumulate_grad_batches": 8,
    "seed": 27,
    "save_every_n_steps": 250,
    "save_every_n_seconds": 1800,
    "snapshot_every_n_steps": 5000,
    "checkpoint_log_base": 2,
    "keep_last_checkpoints": null,
    "checkpoint_name": "italian",
    "max_time_seconds": 82800,
    "validate_every_n_steps": 250,
    "validation_max_batches": 50
  },
  "tokenizer": {
    "type": "huggingface",
    "pretrained_name": "tokenizers/gettone",
    "varlen_strategy": "padding"
  },
  "data": {
    "data_root": "datasets/italian/part-000",
    "stage_id": "part-000",
    "batch_size": 4,
    "num_workers": 0,
    "prefetch_buffer": 8,
    "mdat_strategy": "gettone_512",
    "mdat_view": "default",
    "mdat_selection": {
      "max_tokens": 100000000,
      "composition": {
        "wikipedia": "70%",
        "twita": "30%"
      },
      "seed": 27
    }
  },
  "save_dir": "checkpoints/italian",
  "wandb_project": "UniTO-LLM",
  "wandb_run_name": "ItalianLM",
  "wandb_mode": "offline"
}
